{
  "name": "Java & Erlang Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.java",
        "vscjava.vscode-maven",
        "vscjava.vscode-gradle",
        "pgourlain.erlang"
      ]
    }
  },
  "postCreateCommand": "java -version && erl -version && rebar3 --version"
}

